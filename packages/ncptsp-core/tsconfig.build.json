{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022", "DOM"],
    "rootDir": "../..",
    "outDir": "./dist",
    "declaration": true,
    "strict": false,
    "noImplicitAny": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "baseUrl": "../..",
    "paths": {
      "@/*": ["src/*"],
      "next/cache": ["packages/ncptsp-core/shim/next-cache"],
      "next/server": ["packages/ncptsp-core/shim/next-server"],
      "next/headers": ["packages/ncptsp-core/shim/next-headers"],
      "next/navigation": ["packages/ncptsp-core/shim/next-navigation"],
      "react/cache": ["packages/ncptsp-core/shim/react-cache"],
      "@/components/grid/types": ["packages/ncptsp-core/shim/grid-types"]
    }
  },
  "include": ["../../src/lib/**/*", "shim/**/*.ts"]
}